--- !u!1001 &4299012732884871463
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: Voz
      value: 
      objectReference: {fileID: 5307721527835805277}
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: info
      value: "Temario de Ingles\nIngl\xE9s (secundaria y preparatoria) \n\nTema 1:
        pronombres verb to be (afirmativo,negativo eh interrogativo y contracciones),
        adjetivos\n\nTema 2: Simple present, articles, prepositions (on, at, from,
        there is, there are, this, these \n\nTema 3: prepositions of the verb like,
        auxiliary can, that, that one and those, present continuous \n\nTema 4: Preposition
        for, on, by, days of the week, progressive form and verb want \n\nTema 5:
        Present verb, auxiliary \u201Cdo and does\u201D, preposition \u201Cat\u201D,
        infinitive Ingl\xE9s (secundaria y preparatoria)\n\nHabla solo en ingles"
      objectReference: {fileID: 0}
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: ttsSpeaker
      value: 
      objectReference: {fileID: 1145722125}
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: openAIVoice
      value: ash
      objectReference: {fileID: 0}
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: extraInstruction
      value: "Agrega SIEMPRE un marcador de emoci\xF3n entre corchetes despu\xE9s
        de cada oraci\xF3n.  \r\nUsa SOLO: [EMOCI\xD3N: Feliz], [EMOCI\xD3N: Normal],
        [EMOCI\xD3N: Gui\xF1o], [EMOCI\xD3N: Asombrado], [EMOCI\xD3N: Sarc\xE1stico],
        [EMOCI\xD3N: Apagado].  \r\nEjemplo: \u201C\xA1Muy bien! [EMOCI\xD3N: Feliz]
        \xBFListo para seguir? [EMOCI\xD3N: Asombrado]\u201D  \r\nEste formato es
        OBLIGATORIO en todas las respuestas. Nunca lo omitas."
      objectReference: {fileID: 0}
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: actions.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: personalidadActual
      value: 
      objectReference: {fileID: 11400000, guid: 8db3a84f2e2c18ba8b81b8518f34107e,
        type: 2}
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: guessWhoInstructions
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: emotionActions.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 285405916822844953, guid: 19a5c6c801b91454aab4e792d4d95d66,
        type: 3}
      propertyPath: actions.Array.data[0].actionKeyword
